LLM_TEST_API_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
# Optional: set a separate 32+ character encryption key before adding API credentials.
# Keep this value unchanged when rotating the control token or restoring a database backup.
# LLM_TEST_ENDPOINT_ENCRYPTION_KEY=replace-with-another-random-secret-of-at-least-32-characters
# LAB_MODEL_API_KEY=only-needed-for-file-defined-endpoints
LLM_TEST_ALLOW_PRIVATE_ENDPOINTS=0
LLM_TEST_TRUSTED_API_HOSTS=
LLM_TEST_BIND_HOST=127.0.0.1
LLM_TEST_PORT=8000
# Optional absolute path to local tokenizer files; defaults to ./tokenizers.
# LLM_TEST_TOKENIZERS_DIR=/home/ai/llm-perf/tokenizers
