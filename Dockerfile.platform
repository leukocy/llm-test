FROM node:22-alpine AS frontend-builder
WORKDIR /ui
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM python:3.12-slim AS python-builder
WORKDIR /build
ARG PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
COPY pyproject.toml ./
RUN python -c "import tomllib; deps=tomllib.load(open('pyproject.toml','rb'))['project']['dependencies']; open('/tmp/deps.txt','w').write('\n'.join(deps))" \
    && pip install --no-cache-dir --timeout 60 --retries 5 --index-url "$PIP_INDEX_URL" -r /tmp/deps.txt

FROM python:3.12-slim
ENV PYTHONPATH=/app PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY --from=python-builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=python-builder /usr/local/bin /usr/local/bin
COPY . /app
COPY --from=frontend-builder /ui/dist /app/frontend/dist
RUN mkdir -p /app/data /app/results /app/cache /app/api_logs /app/quality_results /app/datasets /app/test_progress \
    && useradd --system --uid 10001 --home /app llmtest \
    && chown -R llmtest:llmtest /app/data /app/results /app/cache /app/api_logs /app/quality_results /app/datasets /app/test_progress
USER 10001:10001
EXPOSE 8000
CMD ["uvicorn", "server.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
